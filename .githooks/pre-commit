#!/bin/sh
# Format staged PHP files in backend/ with Pint, then re-stage them.
ROOT="$(git rev-parse --show-toplevel)"
. "$ROOT/.githooks/_composer.sh"
cd "$ROOT/backend" || exit 0

FILES=$(git diff --cached --name-only --diff-filter=ACMR --relative -- '*.php')
[ -z "$FILES" ] && exit 0

echo "pre-commit: formatting staged PHP files with Pint"
# shellcheck disable=SC2086
composer_run exec --quiet pint -- $FILES || exit 1
# shellcheck disable=SC2086
git add $FILES
