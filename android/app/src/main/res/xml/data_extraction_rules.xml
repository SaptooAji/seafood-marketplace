<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the DataStore files (the API token from #230) never go to a
     cloud backup or to a new phone (MOB-7). The seller signs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
