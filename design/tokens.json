{
  "$description": "Seafood Marketplace design tokens, palette Bakau dan Kepiting (9c) on a sand background. Source of truth for backend/resources/css/app.css and design/android. Keep in sync with docs/ui-guidelines.md (checked by tests/Feature/Web/VisualIdentityTest.php).",
  "color": {
    "primary-50": { "$value": "#E3EEE7", "$description": "Positive label background (ready to ship)" },
    "primary-100": { "$value": "#CFE3D7", "$description": "Soft highlight" },
    "primary-600": { "$value": "#3A6E55", "$description": "Focus ring and hover border" },
    "primary-700": { "$value": "#2F5D46", "$description": "Mangrove green: primary button, selected option, link, theme-color" },
    "primary-800": { "$value": "#244A38", "$description": "Pressed primary button, text on primary-50" },
    "accent-50": { "$value": "#FBEEE5", "$description": "Stock warning background" },
    "accent-500": { "$value": "#D9733C", "$description": "Crab orange: logo dot and decoration only, never text" },
    "accent-700": { "$value": "#97461C", "$description": "Stock warning text" },
    "ink": { "$value": "#1B2E25", "$description": "Body text, active chip, footer" },
    "muted": { "$value": "#575C52", "$description": "Secondary text: unit, city, distance" },
    "surface": { "$value": "#F6F3EC", "$description": "Sand page background" },
    "subtle": { "$value": "#ECE6DA", "$description": "Photo placeholder, disabled button" },
    "line": { "$value": "#E5DFD3", "$description": "Dividers, header border" },
    "line-strong": { "$value": "#878C80", "$description": "Form field border (3:1)" },
    "success-50": { "$value": "#E3EEE7", "$description": "Alias of primary-50 for positive states" },
    "success-700": { "$value": "#2F5D46", "$description": "Alias of primary-700: WhatsApp and confirm buttons" },
    "success-800": { "$value": "#244A38", "$description": "Alias of primary-800: pressed state" },
    "warning-50": { "$value": "#FBEEE5", "$description": "Alias of accent-50" },
    "warning-200": { "$value": "#E9C2A6", "$description": "Pre-order box border" },
    "warning-700": { "$value": "#97461C", "$description": "Alias of accent-700" },
    "danger-50": { "$value": "#FCE9E6", "$description": "Error and out of stock background" },
    "danger-700": { "$value": "#A8321F", "$description": "Validation error, out of stock" },
    "pattern": { "$value": "#DCCFB6", "$description": "Sea pattern stroke on the sand background (optional)" }
  },
  "font": {
    "family": { "$value": "Schibsted Grotesk", "$description": "One family, weights 400 to 800, SIL OFL 1.1" },
    "scale": {
      "display": { "size": 52, "weight": 800, "tracking": -2 },
      "title": { "size": 32, "weight": 800, "tracking": -1 },
      "section": { "size": 22, "weight": 800, "tracking": -0.5 },
      "price": { "size": 19, "weight": 800, "tracking": -0.4 },
      "body": { "size": 16, "weight": 400, "tracking": 0 },
      "caption": { "size": 13, "weight": 500, "tracking": 0 }
    }
  },
  "radius": {
    "photo": { "$value": 16 },
    "option": { "$value": 18 },
    "card": { "$value": 22 },
    "feature": { "$value": 28 },
    "pill": { "$value": 999 }
  },
  "spacing": { "$value": [4, 8, 12, 16, 24, 32, 48] },
  "touchTarget": { "$value": 44 }
}
